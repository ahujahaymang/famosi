# =============================================================================
# Famosi — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# ── Telegram ──────────────────────────────────────────────────────────────────
BOT_MODE=polling                  # "polling" (no domain needed) or "webhook" (requires HTTPS + domain)
TELEGRAM_BOT_TOKEN=               # Bot token from @BotFather
TELEGRAM_WEBHOOK_SECRET=          # Only required when BOT_MODE=webhook
TELEGRAM_WEBHOOK_URL=             # Full HTTPS URL for webhook registration, e.g. https://yourdomain.com/webhook

# ── OpenAI (Nano / Mini tiers) ────────────────────────────────────────────────
OPENAI_API_KEY=                   # OpenAI API key for router, extraction, and conversation tiers

# ── LLM Model Names ───────────────────────────────────────────────────────────
ROUTER_MODEL=gpt-4.1-nano         # Model used for intent classification (Nano tier)
EXTRACTION_MODEL=gpt-4.1-nano     # Model used for data extraction (Nano tier)
CONVERSATION_MODEL=gpt-4.1-mini   # Model used for short conversational replies (Mini tier)
REASONING_MODEL=anthropic.claude-sonnet-4-5-20251001-v1:0  # Bedrock model ID for reasoning/summaries
ESCALATION_MODEL=anthropic.claude-sonnet-4-5-20251001-v1:0 # Bedrock model ID for emergency escalation
EMBEDDING_MODEL=text-embedding-3-small  # OpenAI embedding model (1536 dims)

# ── LLM Provider Per Tier ─────────────────────────────────────────────────────
LLM_PROVIDER_NANO=openai          # Provider for Nano tier: openai
LLM_PROVIDER_MINI=openai          # Provider for Mini tier: openai
LLM_PROVIDER_REASONING=bedrock    # Provider for reasoning tier: bedrock (AWS)
LLM_PROVIDER_ESCALATION=bedrock   # Provider for escalation tier: bedrock (AWS)

# ── AWS (Bedrock for reasoning/escalation + S3 for storage) ───────────────────
AWS_ACCESS_KEY_ID=                # AWS IAM access key (needs Bedrock + S3 permissions)
AWS_SECRET_ACCESS_KEY=            # AWS IAM secret key
AWS_REGION=us-east-1              # Primary AWS region
AWS_BEDROCK_REGION=us-east-1      # AWS region where Bedrock is invoked
S3_BUCKET_SUMMARIES=famosi-summaries  # S3 bucket for doctor visit PDF summaries
S3_BUCKET_BACKUPS=famosi-backups      # S3 bucket for database backups

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/famosi  # Async PostgreSQL DSN

# ── Redis (optional — session state & confirmation cache) ─────────────────────
REDIS_URL=redis://localhost:6379/0  # Redis connection URL; leave empty to use in-process fallback

# ── Payments — Razorpay (India) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=                  # Razorpay API key ID
RAZORPAY_KEY_SECRET=              # Razorpay API key secret
RAZORPAY_WEBHOOK_SECRET=          # Secret for validating Razorpay webhook signatures

# ── Payments — Stripe (USA) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=                # Stripe secret API key
STRIPE_WEBHOOK_SECRET=            # Stripe webhook signing secret
STRIPE_PRICE_ID=                  # Stripe Price ID for the subscription plan

# ── Application ───────────────────────────────────────────────────────────────
JOB_SECRET=                       # Shared secret for authenticating EventBridge → EC2 job endpoints
CURRENT_POLICY_VERSION=1.0        # Current privacy policy / ToS version (re-consent on change)
LOG_LEVEL=INFO                    # Logging verbosity: DEBUG | INFO | WARNING | ERROR
